# ---------------------------------------------------------------------------
# OpenCode Go Router
# Copy this file to .env and fill in the two required values.
# ---------------------------------------------------------------------------

# Required: your OpenCode Go personal API key from https://opencode.ai/console
OPENCODE_API_KEY=oc_sk_replace_me

# Dashboard password, minimum 12 characters.
# Leave blank to generate a one-time password and print it in the container logs.
ADMIN_PASSWORD=

# Recovery only: when true, ADMIN_PASSWORD overwrites the stored password on
# startup and signs out all sessions. Set back to false afterwards.
ADMIN_PASSWORD_RESET=false

# Optional: the URL your friends will use to reach this router.
# If empty, the generated client config uses the URL you are browsing from.
# Set this when the dashboard is reached through a LAN address or a reverse proxy.
# PUBLIC_URL=https://go.example.com

# Optional: go | go-plus. Can also be changed in the dashboard.
PLAN=go

# Optional: upstream base URL. Only change this if OpenCode changes its API host.
# UPSTREAM_BASE_URL=https://opencode.ai/inference

# Optional: request log retention in days.
RETENTION_DAYS=180

# Optional: set true only when running behind a trusted reverse proxy
# (Caddy, nginx, Traefik). Enables X-Forwarded-For/Proto/Host.
TRUST_PROXY=false

# Optional: session lifetime in hours.
SESSION_TTL_HOURS=168

# Optional: how often the live model list is refreshed.
MODELS_REFRESH_MINUTES=15

# Optional: maximum request body size in MB (large coding contexts need room).
MAX_BODY_MB=64

# Optional: text | json, and debug | info | warn | error.
LOG_FORMAT=text
LOG_LEVEL=info
